# ============================================================
# À placer dans le fichier .htaccess (Apache / LiteSpeed)
# ============================================================

# --- A) Sur grilvex.ma : forcer HTTPS + www (une seule version du site) ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.grilvex.ma/$1 [R=301,L]

# --- B) Sur l'ANCIEN site Zwawri : redirection 301 vers GRILVEX ---
# Remplacez "ancien-domaine-zwawri.ma" par le vrai domaine de Zwawri.
# (à mettre dans le .htaccess de l'ancien domaine, pas du nouveau)
#
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^(www\.)?ancien-domaine-zwawri\.ma$ [NC]
# RewriteRule ^(.*)$ https://www.grilvex.ma/ [R=301,L]